<%= content_for :page_title, t(".title") %>
<%= content_for :page_actions do %>
  <% unless Current.user&.guest? %>
    <%= render DS::Link.new(
      text: t(".new"),
      variant: "primary",
      href: new_custom_instrument_path,
      icon: "plus",
      frame: :modal
    ) %>
  <% end %>
<% end %>

<div class="space-y-4">
  <section class="bg-container rounded-xl shadow-border-xs p-4">
    <% if @instruments.any? %>
      <div class="rounded-xl bg-container-inset space-y-1 p-1">
        <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
          <p><%= t(".instruments") %></p>
          <span class="text-subdued">&middot;</span>
          <p><%= @instruments.count %></p>
        </div>

        <div id="active_custom_instruments" class="bg-container rounded-lg shadow-border-xs">
          <div class="overflow-hidden rounded-lg">
            <% @instruments.each_with_index do |instrument, index| %>
              <%= render "shared/ruler" if index.positive? %>
              <%= render "custom_instruments/instrument",
                    instrument: instrument,
                    latest_price: @latest_prices[instrument.security_id],
                    previous_price: @previous_prices[instrument.security_id],
                    positions: @positions[instrument.security_id] || [],
                    status: @statuses[instrument.id] %>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <%= render DS::EmptyState.new(
            icon: "coins",
            title: t(".empty_title"),
            description: t(".empty_description")
          ) do |empty_state| %>
        <% unless Current.user&.guest? %>
          <% empty_state.with_action do %>
            <div class="flex flex-col items-center gap-4">
              <%= render DS::Link.new(
                text: t(".empty_action"),
                variant: "primary",
                href: new_custom_instrument_path,
                icon: "plus",
                frame: :modal
              ) %>

              <div class="space-y-2">
                <p class="text-xs text-secondary"><%= t(".empty_templates") %></p>
                <div class="flex flex-wrap justify-center gap-2">
                  <% @quick_start_templates.each do |template| %>
                    <%= render DS::Link.new(
                      text: template.name,
                      variant: "secondary",
                      href: new_custom_instrument_path(template: template.key),
                      frame: :modal
                    ) %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <% if @archived_instruments.any? %>
    <section id="archived_custom_instruments" class="bg-container rounded-xl shadow-border-xs p-4">
      <%= render DS::Disclosure.new(
            title: t(".archived_title", count: @archived_instruments.count),
            align: :left
          ) do %>
        <div class="bg-container rounded-lg shadow-border-xs mt-2">
          <div class="overflow-hidden rounded-lg">
            <% @archived_instruments.each_with_index do |instrument, index| %>
              <%= render "shared/ruler" if index.positive? %>
              <%= render "custom_instruments/instrument",
                    instrument: instrument,
                    latest_price: @latest_prices[instrument.security_id],
                    previous_price: @previous_prices[instrument.security_id],
                    positions: @positions[instrument.security_id] || [],
                    status: @statuses[instrument.id] %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
