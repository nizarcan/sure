<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", symbol: @instrument.symbol)) %>
  <% dialog.with_body do %>
    <% if @accounts.any? %>
      <div class="space-y-3">
        <p class="text-sm text-secondary"><%= t(".description") %></p>

        <ul class="divide-y divide-subdued overflow-hidden rounded-lg bg-container-inset">
          <% @accounts.each do |account| %>
            <% href = if account.custom_instrument_id == @instrument.id
                 new_account_unit_balance_path(account, mode: "add")
               else
                 new_trade_path(account_id: account.id, type: "transfer_in", security: "#{@instrument.security.ticker}||custom")
               end %>
            <li>
              <%= render DS::Link.new(
                    text: account.name,
                    variant: "ghost",
                    href: href,
                    icon: "plus",
                    icon_position: :right,
                    frame: :modal,
                    class: "w-full justify-between p-4 text-sm"
                  ) %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <%= render DS::EmptyState.new(
            icon: "wallet",
            title: t(".empty_title"),
            description: t(".empty_description")
          ) do |empty_state| %>
        <% empty_state.with_action do %>
          <%= render DS::Link.new(
                text: t(".empty_action"),
                variant: "primary",
                href: new_investment_path(instrument: @instrument.id),
                icon: "plus",
                frame: :modal
              ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
